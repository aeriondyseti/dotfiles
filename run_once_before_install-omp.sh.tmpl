{{ if ne .profile "windows" -}}
#!/bin/bash
# Install Oh My Posh — managed by chezmoi
{{ if or (eq .profile "server") (eq .profile "omarchy") -}}
# Server and Omarchy profiles: skip OMP installation (Omarchy uses Starship)
exit 0
{{ end -}}
set -euo pipefail

if ! command -v oh-my-posh &>/dev/null; then
    echo "Installing Oh My Posh..."
    curl -s https://ohmyposh.dev/install.sh | bash -s
fi

echo "Oh My Posh setup complete."
{{- end }}
