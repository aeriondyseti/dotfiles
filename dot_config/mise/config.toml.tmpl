{{- if eq .profile "windows" }}
[tools]
# .NET is provided by Visual Studio on Windows, so it is intentionally omitted.
python = "3.13"
uv = "latest"
node = "lts"
bun = "latest"
kotlin = "2.3"
{{- else if eq .profile "omarchy" }}
[tools]
# claude/codex/gh/node come from Omarchy's own mise setup; the rest are ours.
# Kotlin and .NET are left out here (add them back if needed).
bun = "latest"
claude = "latest"
codex = "latest"
gh = "latest"
node = "26.8.2"
python = "3.13"
uv = "latest"

[settings.upgrade]
auto_prune = false
{{- else if ne .profile "server" }}
[tools]
python = "3.13"
uv = "latest"
node = "lts"
bun = "latest"
kotlin = "2.3"
dotnet = "10"
{{- else }}
[tools]
python = "3.13"
{{- end }}
